@pytest.mark.parametrize("product_id, quantity, expected_error", [
    (999, 1, KeyError),
    (1, 100, ValueError),
    (2, -1, ValueError)
])
def test_invalid_operations(empty_cart, sample_products, product_id, quantity, expected_error):
    cart = empty_cart
    product_map = {p.id: p for p in sample_products}
    
    if product_id in product_map:
        cart.add_item(product_map[product_id], 1)  # 先添加有效商品
    
    with pytest.raises(expected_error):
        if expected_error == KeyError:
            cart.remove_item(product_id, quantity)
        else:
            cart.add_item(product_map[product_id], quantity)

