from typing import Dict, List, Tuple, Optional

class Product:
    def __init__(self, id: int, name: str, price: float, stock: int):
        self.id = id
        self.name = name
        self.price = price
        self.stock = stock

    def apply_discount(self, discount: float) -> None:
        if not 0 <= discount <= 1:
            raise ValueError("折扣必须在0到1之间")
        self.price *= (1 - discount)

class ShoppingCart:
    def __init__(self):
        self.items: Dict[int, Tuple[Product, int]] = {}  # {product_id: (product, quantity)}
    
    def add_item(self, product: Product, quantity: int=1) -> None:
        if product.stock < quantity:
            raise ValueError("库存不足")
        
        if product.id in self.items:
            existing_product, existing_quantity = self.items[product.id]
            self.items[product.id] = (existing_product, existing_quantity + quantity)
        else:
            self.items[product.id] = (product, quantity)
    
    def remove_item(self, product_id: int, quantity: int=1) -> None:
        if product_id not in self.items:
            raise KeyError("商品不存在于购物车中")
        
        product, existing_quantity = self.items[product_id]
        if existing_quantity <= quantity:
            del self.items[product_id]
        else:
            self.items[product_id] = (product, existing_quantity - quantity)
    
    @property
    def total_price(self) -> float:
        return sum(product.price * quantity for product, quantity in self.items.values())
    
    def checkout(self, payment_gateway) -> bool:
        total = self.total_price
        if payment_gateway.process_payment(total):
            for product, quantity in self.items.values():
                product.stock -= quantity
            self.items.clear()
            return True
        return False

class PaymentGateway:
    def process_payment(self, amount: float) -> bool:
        """模拟支付处理，实际应调用外部API"""
        raise NotImplementedError

