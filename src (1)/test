class TestShoppingCartBasic:
    """基础功能测试"""
    
    def test_add_item(self, empty_cart, sample_products):
        cart = empty_cart
        product = sample_products[0]
        cart.add_item(product, 2)
        assert len(cart.items) == 1
        assert cart.items[1][1] == 2
    
    def test_remove_item(self, empty_cart, sample_products):
        cart = empty_cart
        product = sample_products[0]
        cart.add_item(product, 3)
        cart.remove_item(1, 2)
        assert cart.items[1][1] == 1
    
    @pytest.mark.parametrize("quantity, expected", [
        (5, 5*99.99),
        (3, 3*99.99),
        (0, 0)
    ])
    def test_total_price(self, empty_cart, sample_products, quantity, expected):
        cart = empty_cart
        if quantity > 0:
            cart.add_item(sample_products[0], quantity)
        assert cart.total_price == pytest.approx(expected, rel=1e-3)

class TestCheckoutProcess:
    """结账流程测试"""
    
    @pytest.mark.usefixtures("mock_payment_gateway")
    def test_successful_checkout(self, empty_cart, sample_products, mock_payment_gateway):
        cart = empty_cart
        product = sample_products[0]
        initial_stock = product.stock
        
        cart.add_item(product, 2)
        result = cart.checkout(mock_payment_gateway)
        
        assert result is True
        assert len(cart.items) == 0
        assert product.stock == initial_stock - 2
        mock_payment_gateway.process_payment.assert_called_once_with(pytest.approx(2*99.99, rel=1e-3))
    
    def test_checkout_failure(self, empty_cart, sample_products):
        cart = empty_cart
        product = sample_products[0]
        initial_stock = product.stock
        
        cart.add_item(product, 2)
        
        # 使用mock模拟支付失败
        mock_payment = Mock()
        mock_payment.process_payment.return_value = False
        
        result = cart.checkout(mock_payment)
        
        assert result is False
        assert len(cart.items) == 2
        assert product.stock == initial_stock

class TestEdgeCases:
    """边界条件测试"""
    
    @pytest.mark.parametrize("discount, expected_price", [
        (0.1, 89.991),
        (0.5, 49.995),
        (0, 99.99)
    ])
    def test_product_discount(self, sample_products, discount, expected_price):
        product = sample_products[0]
        original_price = product.price
        product.apply_discount(discount)
        assert product.price == pytest.approx(expected_price, rel=1e-3)
        product.price = original_price  # 重置状态
    
    @pytest.mark.parametrize("invalid_discount", [
        -0.1, 1.1, 2.0
    ])
    def test_invalid_discount(self, sample_products, invalid_discount):
        product = sample_products[0]
        with pytest.raises(ValueError) as excinfo:
            product.apply_discount(invalid_discount)
        assert "折扣必须在0到1之间" in str(excinfo.value)

